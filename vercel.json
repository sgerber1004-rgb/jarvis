{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/canvas.js": {
      "runtime": "edge"
    }
  },
  "routes": [
    {
      "src": "/api/canvas",
      "dest": "/api/canvas.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
